---
import RelationCard from "../../components/astro/RelationCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const cases = await getCollection("cases");
---

<BaseLayout title="案例" description="Python 真实案例库。">
  <header class="section-header">
    <div>
      <p class="eyebrow">Cases</p>
      <h1>真实案例</h1>
    </div>
  </header>
  <div class="grid cols-3">
    {cases.map((entry) => (
      <RelationCard href={`/cases/${entry.id}/`} title={entry.data.title} description={entry.data.description} meta={entry.data.level} />
    ))}
  </div>
</BaseLayout>

<style>
  h1 {
    margin: 0;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.08;
    letter-spacing: 0;
  }
</style>
