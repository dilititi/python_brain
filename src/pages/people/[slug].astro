---
import { getCollection } from "astro:content";
import PersonLayout from "../../layouts/PersonLayout.astro";
import { getAllContent, resolveMany } from "../../lib/relations";

export async function getStaticPaths() {
  const people = await getCollection("people");
  return people.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { concepts } = await getAllContent();
---

<PersonLayout entry={entry} concepts={resolveMany(concepts, entry.data.concepts)} />
