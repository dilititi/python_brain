---
import { getCollection } from "astro:content";
import PhilosophyWorkflowNav from "../../components/philosophy/PhilosophyWorkflowNav.astro";
import PhilosophyLayout from "../../layouts/PhilosophyLayout.astro";
import { groupPhilosophyContentByAbility } from "../../lib/philosophy-abilities";
import { buildRecentStanceChanges } from "../../lib/philosophy-search";

const [entries, questions, readings, claims, sources, notions] = await Promise.all([
  getCollection("entries"),
  getCollection("questions"),
  getCollection("readings"),
  getCollection("understanding-claims"),
  getCollection("sources"),
  getCollection("notions")
]);

const rows = buildRecentStanceChanges({
  entries,
  questions,
  readings,
  perspectives: [],
  notions: [],
  sources: []
});

const statusLabels = {
  open: "持续追问",
  provisional: "已有暂定回答",
  settled: "阶段性稳定",
  draft: "草稿",
  testing: "检验中",
  supported: "已有证据支持",
  contested: "存在反证",
  revised: "已修订",
  retired: "已搁置",
  saved: "已保存",
  skimmed: "已浏览",
  reading: "阅读中",
  read: "已读",
  extracted: "已提取",
  rejected: "已弃用"
} as const;
const confidenceLabels = {
  low: "低信心",
  medium: "中等信心",
  high: "高信心"
} as const;
const reliabilityLabels = {
  high: "高可靠性",
  medium: "中等可靠性",
  low: "低可靠性",
  unknown: "可靠性未判断"
} as const;
const currentDate = new Date();
const staleQuestionStatuses = new Set(["open", "provisional", "active", "developing"]);
const activeQuestionStatuses = new Set(["open", "provisional", "active", "developing"]);
const evidenceModeTypes = new Set(["critique", "comparison", "application"]);

function daysSince(date: string | undefined) {
  if (!date) return Number.POSITIVE_INFINITY;
  const parsed = new Date(`${date}T00:00:00Z`);
  if (Number.isNaN(parsed.getTime())) return Number.POSITIVE_INFINITY;
  return Math.floor((currentDate.getTime() - parsed.getTime()) / (1000 * 60 * 60 * 24));
}

const stalledQuestions = questions
  .map((question) => ({
    question,
    age: daysSince(question.data.updatedAt)
  }))
  .filter(({ question, age }) => staleQuestionStatuses.has(question.data.status) && age > 30);

const claimEvidenceWarnings = claims.flatMap((claim) => {
  const warnings: string[] = [];
  if (["testing", "supported"].includes(claim.data.status) && claim.data.evidence.length === 0) {
    warnings.push("testing / supported claim 还没有 evidence。");
  }
  if (claim.data.confidence === "high" && claim.data.evidence.length < 2) {
    warnings.push("high confidence claim 的 evidence 少于 2 条。");
  }
  if (claim.data.confidence === "high" && !claim.data.evidence.some((item) => evidenceModeTypes.has(item.type))) {
    warnings.push("high confidence claim 还没有 critique / comparison / application 类型 evidence。");
  }
  return warnings.map((warning) => ({ claim, warning }));
});

const unprocessedSources = sources.filter((source) => ["saved", "skimmed"].includes(source.data.status));
const activeQuestions = questions.filter((question) => activeQuestionStatuses.has(question.data.status));
const untaggedActiveQuestions = activeQuestions.filter((question) => question.data.abilities.length === 0);
const untaggedCoreNotions = notions.filter((notion) => notion.data.abilities.length === 0);
const abilityGroups = groupPhilosophyContentByAbility({ notions, questions });
const maxAbilityTotal = Math.max(...abilityGroups.map((group) => group.total));
const minAbilityTotal = Math.min(...abilityGroups.map((group) => group.total));
const concentratedAbilityGroups = abilityGroups.filter((group) => group.total === maxAbilityTotal && group.total > 0);
const leastCoveredAbilityGroups = abilityGroups.filter((group) => group.total === minAbilityTotal);
---

<PhilosophyLayout
  title="近期立场变化"
  description="按时间回看阅读如何改变当前判断。"
  breadcrumbs={[
    { label: "首页", href: "/" },
    { label: "思想工作台", href: "/philosophy/" },
    { label: "近期立场变化" }
  ]}
>
  <header class="ph-hero">
    <p class="eyebrow">Review</p>
    <h1>近期立场变化</h1>
    <p class="lead">这里不是普通博客归档，而是按时间回看：哪次阅读让我的判断从 Vn 变成 Vn+1，以及仍留下什么问题。</p>
  </header>

  <PhilosophyWorkflowNav current="review" />

  <section class="ph-section" aria-labelledby="review-dashboard-heading">
    <div class="ph-section-heading">
      <p class="eyebrow">Dashboard panels</p>
      <h2 id="review-dashboard-heading">学习回顾面板</h2>
      <p>把停滞问题、证据不足的理解主张和未处理资料先捞出来；这些是 warnings，不会让 build fail。</p>
    </div>

    <div class="ph-dashboard-grid">
      <section class="ph-question-card" data-review-panel="stalled-questions">
        <div class="ph-section-heading">
          <h3>Stalled active questions</h3>
          <p>超过 30 天未更新的开放/暂定问题。</p>
        </div>
        {stalledQuestions.length > 0 ? (
          <ul class="ph-compact-list">
            {stalledQuestions.map(({ question, age }) => (
              <li>
                <a href={`/questions/${question.id}/`}>{question.data.title}</a>
                <p>{age} 天未更新。</p>
                <div class="ph-card-meta">
                  <span>{statusLabels[question.data.status]}</span>
                  <span>更新于 {question.data.updatedAt}</span>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="ph-empty">当前没有停滞问题。</p>
        )}
      </section>

      <section class="ph-question-card" data-review-panel="claims-needing-evidence">
        <div class="ph-section-heading">
          <h3>Claims needing evidence</h3>
          <p>证据数量或证据类型不足的 understanding claims。</p>
        </div>
        {claimEvidenceWarnings.length > 0 ? (
          <ul class="ph-compact-list">
            {claimEvidenceWarnings.map(({ claim, warning }) => (
              <li>
                <a href={`/understanding-claims/${claim.id}/`}>{claim.data.title}</a>
                <p>{warning}</p>
                <div class="ph-card-meta">
                  <span>{statusLabels[claim.data.status]}</span>
                  <span>{confidenceLabels[claim.data.confidence]}</span>
                  <span>{claim.data.evidence.length} 条证据</span>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="ph-empty">当前没有证据不足的 claim。</p>
        )}
      </section>

      <section class="ph-question-card" data-review-panel="unprocessed-sources">
        <div class="ph-section-heading">
          <h3>Unprocessed sources</h3>
          <p>仍处在 saved / skimmed 的资料；medium / low / unknown reliability 会被标出。</p>
        </div>
        {unprocessedSources.length > 0 ? (
          <ul class="ph-compact-list">
            {unprocessedSources.map((source) => {
              const needsReliabilityReview = source.data.reliability !== "high";
              return (
                <li>
                  <a href={`/sources/${source.id}/`}>{source.data.title}</a>
                  <p>{source.data.summary}</p>
                  <div class="ph-card-meta">
                    <span>{statusLabels[source.data.status]}</span>
                    <span>{reliabilityLabels[source.data.reliability]}</span>
                    {needsReliabilityReview && <span>需要可靠性复核</span>}
                  </div>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="ph-empty">当前没有未处理 source。</p>
        )}
      </section>

      <section class="ph-question-card" data-review-panel="ability-coverage">
        <div class="ph-section-heading">
          <h3>Ability Lens coverage</h3>
          <p>只回看 questions / notions 的能力维度标注；这里的数量表示关联内容数量。</p>
        </div>

        <div class="ph-ability-review-block">
          <h4>未标注 active questions</h4>
          {untaggedActiveQuestions.length > 0 ? (
            <ul class="ph-compact-list">
              {untaggedActiveQuestions.map((question) => (
                <li><a href={`/questions/${question.id}/`}>{question.data.title}</a></li>
              ))}
            </ul>
          ) : (
            <p class="ph-empty">当前 active questions 都已标注 abilities。</p>
          )}
        </div>

        <div class="ph-ability-review-block">
          <h4>未标注核心 notions</h4>
          {untaggedCoreNotions.length > 0 ? (
            <ul class="ph-compact-list">
              {untaggedCoreNotions.map((notion) => (
                <li><a href={`/notions/${notion.id}/`}>{notion.data.title}</a></li>
              ))}
            </ul>
          ) : (
            <p class="ph-empty">当前核心 notions 都已标注 abilities。</p>
          )}
        </div>

        <div class="ph-ability-review-block">
          <h4>每个 ability 下的内容数量</h4>
          <ul class="ph-compact-list">
            {abilityGroups.map((group) => (
              <li data-ability-review-count={group.ability}>
                <span><strong>{group.meta.label}</strong>：{group.total} 个关联内容</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="ph-ability-review-block">
          <h4>内容最少的 ability 维度</h4>
          <p class="muted">这些维度的关联内容较少，尚未充分覆盖。</p>
          <ul class="ph-compact-list">
            {leastCoveredAbilityGroups.map((group) => (
              <li>
                <span><strong>{group.meta.label}</strong>：{group.total} 个关联内容</span>
              </li>
            ))}
          </ul>
        </div>

        <p class="muted">
          当前内容集中于这些维度：{concentratedAbilityGroups.map((group) => group.meta.label).join("、") || "暂无明显集中维度"}。
        </p>
      </section>
    </div>
  </section>

  <section class="ph-section" aria-labelledby="review-list-heading">
    <div class="ph-section-heading">
      <h2 id="review-list-heading">判断变化记录</h2>
      <p>最新变化排在最前；每张卡只摘要证据链，完整说明仍在 entry 页面。</p>
    </div>
    <div class="ph-filter-panel" data-review-filters>
      <label>
        <span>筛选问题</span>
        <select aria-label="筛选问题" data-review-filter="question">
          <option value="all">全部问题</option>
          {questions.map((question) => <option value={question.id}>{question.data.title}</option>)}
        </select>
      </label>
      <p class="muted" data-review-count>{rows.length} 次变化</p>
    </div>

    {rows.length > 0 ? (
      <div class="ph-review-list">
        {rows.map((row) => (
          <article class="ph-timeline-node" data-review-card={row.id} data-review-question={row.questionId}>
            <span class="ph-version">{row.date} · V{row.fromVersion} → V{row.toVersion}</span>
            <h3><a href={row.href}>{row.title}</a></h3>
            <p><strong>问题：</strong><a href={`/questions/${row.questionId}/`}>{row.questionTitle}</a></p>
            {row.readingId && <p><strong>触发阅读：</strong><a href={`/readings/${row.readingId}/`}>{row.readingTitle}</a></p>}
            <p><strong>为什么改变：</strong>{row.reason}</p>
            <p><strong>新立场：</strong>{row.newStance}</p>
            {row.accepted.length > 0 && <p><strong>接受：</strong>{row.accepted.join("；")}</p>}
            {row.doubts.length > 0 && <p><strong>怀疑：</strong>{row.doubts.join("；")}</p>}
            {row.newQuestions.length > 0 && <p><strong>新问题：</strong>{row.newQuestions.join("；")}</p>}
          </article>
        ))}
      </div>
    ) : <p class="ph-empty">还没有 entry 变化记录。</p>}
    <p class="ph-empty" data-review-empty hidden>没有匹配当前问题的变化记录。</p>
  </section>

  <script>
    const filters = document.querySelector("[data-review-filters]");
    if (filters) {
      const select = filters.querySelector<HTMLSelectElement>("select[data-review-filter='question']");
      const cards = document.querySelectorAll<HTMLElement>("[data-review-card]");
      const count = document.querySelector<HTMLElement>("[data-review-count]");
      const empty = document.querySelector<HTMLElement>("[data-review-empty]");

      function update() {
        const question = select?.value ?? "all";
        let visibleCount = 0;
        cards.forEach((card) => {
          const visible = question === "all" || card.dataset.reviewQuestion === question;
          card.hidden = !visible;
          if (visible) visibleCount += 1;
        });
        if (count) count.textContent = `${visibleCount} 次变化`;
        if (empty) empty.hidden = visibleCount !== 0;
      }

      select?.addEventListener("change", update);
      update();
    }
  </script>
</PhilosophyLayout>
