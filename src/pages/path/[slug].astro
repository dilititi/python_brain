---
import { getCollection } from "astro:content";
import PathProgress from "../../components/astro/PathProgress.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPathConcepts } from "../../lib/relations";

export async function getStaticPaths() {
  const paths = await getCollection("paths");
  return paths.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { concepts } = await getPathConcepts(entry.id);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <header class="path-header">
    <p class="eyebrow">{entry.data.track}</p>
    <h1>{entry.data.title}</h1>
    <p class="lead">{entry.data.description}</p>
  </header>
  <section class="section">
    <PathProgress nodes={concepts} milestones={entry.data.milestones} pathId={entry.id} />
  </section>
</BaseLayout>

<style>
  .path-header {
    padding-bottom: 22px;
    border-bottom: 1px solid var(--color-line);
  }

  h1 {
    margin: 0;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.08;
    letter-spacing: 0;
  }
</style>
