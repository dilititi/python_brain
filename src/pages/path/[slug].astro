---
import { getCollection } from "astro:content";
import PathProgress from "../../components/astro/PathProgress.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPathConcepts } from "../../lib/relations";

export async function getStaticPaths() {
  const paths = await getCollection("paths");
  return paths.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { concepts } = await getPathConcepts(entry.id);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <header class="path-header">
    <p class="eyebrow">{entry.data.track}</p>
    <h1>{entry.data.title}</h1>
    <p class="lead">{entry.data.description}</p>
  </header>
  <section class="fit-grid" aria-label="方向适配">
    <article>
      <h2>适合你，如果</h2>
      <ul>
        {entry.data.forWhom.map((item) => <li>{item}</li>)}
      </ul>
    </article>
    <article>
      <h2>先别选，如果</h2>
      <ul>
        {entry.data.notForWhom.map((item) => <li>{item}</li>)}
      </ul>
    </article>
    <article>
      <h2>机会成本</h2>
      <p>{entry.data.opportunityCost}</p>
    </article>
  </section>
  <section class="section">
    <PathProgress nodes={concepts} milestones={entry.data.milestones} pathId={entry.id} />
  </section>
</BaseLayout>

<style>
  .path-header {
    padding-bottom: 22px;
    border-bottom: 1px solid var(--color-line);
  }

  .fit-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin: 22px 0 6px;
  }

  .fit-grid article {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 14px;
    background: var(--color-panel);
  }

  .fit-grid h2 {
    margin: 0 0 10px;
    font-size: 16px;
    line-height: 1.25;
  }

  .fit-grid ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding-left: 18px;
  }

  .fit-grid li,
  .fit-grid p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.6;
  }

  h1 {
    margin: 0;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.08;
    letter-spacing: 0;
  }

  @media (max-width: 860px) {
    .fit-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
