---
import { getCollection } from "astro:content";
import PhilosophyLayout from "../../layouts/PhilosophyLayout.astro";

const [sources, questions] = await Promise.all([
  getCollection("sources"),
  getCollection("questions")
]);
const questionById = new Map(questions.map((question) => [question.id, question]));
const sortedSources = [...sources].sort((a, b) => a.data.title.localeCompare(b.data.title, "zh-CN"));
const reliabilityLabels = { high: "高可靠性", medium: "中等可靠性", low: "低可靠性", unknown: "可靠性未判断" } as const;
const statusLabels = { saved: "已保存", skimmed: "已浏览", reading: "阅读中", read: "已读", extracted: "已提取", rejected: "已弃用" } as const;
---

<PhilosophyLayout
  title="辅助资料库"
  description="按问题保存并判断辅助资料，而不是堆积链接。"
  breadcrumbs={[
    { label: "首页", href: "/" },
    { label: "思想工作台", href: "/philosophy/" },
    { label: "辅助资料库" }
  ]}
>
  <header class="ph-hero">
    <p class="eyebrow">Sources</p>
    <h1>辅助资料库</h1>
    <p class="lead">这里保存导论、百科、课程、视频与网页资料，并明确它服务于哪个问题、为何可信以及有什么局限。</p>
  </header>

  <section class="ph-section" aria-labelledby="source-list-heading">
    <div class="ph-section-heading">
      <h2 id="source-list-heading">已判断的资料</h2>
    </div>
    <div class="ph-filter-panel" data-source-filters>
      <label>
        <span>关联问题</span>
        <select aria-label="关联问题" data-source-filter="question">
          <option value="all">全部问题</option>
          {questions.map((question) => <option value={question.id}>{question.data.title}</option>)}
        </select>
      </label>
      <label>
        <span>可靠性</span>
        <select aria-label="可靠性" data-source-filter="reliability">
          <option value="all">全部可靠性</option>
          <option value="high">高可靠性</option>
          <option value="medium">中等可靠性</option>
          <option value="low">低可靠性</option>
          <option value="unknown">可靠性未判断</option>
        </select>
      </label>
      <label>
        <span>处理状态</span>
        <select aria-label="处理状态" data-source-filter="status">
          <option value="all">全部状态</option>
          <option value="saved">已保存</option>
          <option value="skimmed">已浏览</option>
          <option value="reading">阅读中</option>
          <option value="read">已读</option>
          <option value="extracted">已提取</option>
          <option value="rejected">已弃用</option>
        </select>
      </label>
      <p class="muted" data-source-count>{sortedSources.length} 个 source</p>
    </div>
    {sortedSources.length > 0 ? (
      <div class="ph-question-grid">
        {sortedSources.map((source) => (
          <article
            class="ph-question-card"
            data-source-card={source.id}
            data-source-questions={source.data.relatedQuestions.join(" ")}
            data-source-reliability={source.data.reliability}
            data-source-status={source.data.status}
          >
            <div class="ph-card-meta">
              <span>{source.data.type}</span>
              <span>{reliabilityLabels[source.data.reliability]}</span>
              <span>{statusLabels[source.data.status]}</span>
            </div>
            <h2><a href={`/sources/${source.id}/`}>{source.data.title || "未命名资料"}</a></h2>
            <p>{source.data.summary || "暂未概括这份资料。"}</p>
            <p><strong>为什么保存：</strong>{source.data.whySaved || "尚未记录。"}</p>
            <div class="ph-card-meta">
              <span>关联问题：</span>
              {source.data.relatedQuestions.length > 0
                ? source.data.relatedQuestions.map((slug) => <span>{questionById.get(slug)?.data.title || slug}</span>)
                : <span>未关联</span>}
            </div>
            <a href={`/sources/${source.id}/`}>查看资料判断 →</a>
          </article>
        ))}
      </div>
    ) : (
      <p class="ph-empty">还没有 source。保存第一份辅助资料时，请同时说明它服务于哪个问题。</p>
    )}
    <p class="ph-empty" data-source-empty hidden>没有匹配当前筛选条件的 source。</p>
  </section>

  <script>
    const filters = document.querySelector("[data-source-filters]");
    if (filters) {
      const selects = filters.querySelectorAll<HTMLSelectElement>("select[data-source-filter]");
      const cards = document.querySelectorAll<HTMLElement>("[data-source-card]");
      const count = document.querySelector<HTMLElement>("[data-source-count]");
      const empty = document.querySelector<HTMLElement>("[data-source-empty]");

      function matches(card: HTMLElement) {
        const values = Object.fromEntries([...selects].map((select) => [select.dataset.sourceFilter, select.value]));
        const question = values.question;
        const reliability = values.reliability;
        const status = values.status;

        return (question === "all" || card.dataset.sourceQuestions?.split(" ").includes(String(question)))
          && (reliability === "all" || card.dataset.sourceReliability === reliability)
          && (status === "all" || card.dataset.sourceStatus === status);
      }

      function update() {
        let visibleCount = 0;
        cards.forEach((card) => {
          const visible = matches(card);
          card.hidden = !visible;
          if (visible) visibleCount += 1;
        });
        if (count) count.textContent = `${visibleCount} 个 source`;
        if (empty) empty.hidden = visibleCount !== 0;
      }

      selects.forEach((select) => select.addEventListener("change", update));
      update();
    }
  </script>
</PhilosophyLayout>
