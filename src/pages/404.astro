---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="未找到页面">
  <section class="section">
    <p class="eyebrow">404</p>
    <h1>这个节点还没有接上图谱</h1>
    <p class="lead">返回首页或进入概念索引继续探索。</p>
  </section>
</BaseLayout>

<style>
  h1 {
    margin: 0;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.08;
    letter-spacing: 0;
  }
</style>
