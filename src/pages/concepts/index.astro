---
import RelationCard from "../../components/astro/RelationCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const concepts = await getCollection("concepts");
---

<BaseLayout title="概念" description="Python 知识点索引。">
  <header class="section-header">
    <div>
      <p class="eyebrow">Concepts</p>
      <h1>概念节点</h1>
    </div>
  </header>
  <div class="grid cols-3">
    {concepts.map((entry) => (
      <RelationCard href={`/concepts/${entry.id}/`} title={entry.data.title} description={entry.data.summary} meta={entry.data.category} />
    ))}
  </div>
</BaseLayout>

<style>
  h1 {
    margin: 0;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.08;
    letter-spacing: 0;
  }
</style>
