---
import { render } from "astro:content";
import Breadcrumb from "../components/astro/Breadcrumb.astro";
import RelationCard from "../components/astro/RelationCard.astro";
import type { ConceptEntry, PersonEntry } from "../lib/relations";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  entry: PersonEntry;
  concepts: ConceptEntry[];
}

const { entry, concepts } = Astro.props as Props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.name} description={entry.data.description}>
  <Breadcrumb
    items={[
      { label: "首页", href: "/" },
      { label: "人物", href: "/people/" },
      { label: entry.data.name }
    ]}
  />
  <header class="detail-header">
    <p class="eyebrow">{entry.data.field}</p>
    <h1>{entry.data.name}</h1>
    <p class="lead">{entry.data.role}。{entry.data.description}</p>
  </header>
  <section class="section content-flow">
    {entry.data.quote && (
      <blockquote class="person-quote">{entry.data.quote}</blockquote>
    )}
    {entry.data.earlyCareer && (
      <aside class="early-career">
        <p class="early-career-label">早期线索</p>
        <h2>{entry.data.earlyCareer.ageOrYear}</h2>
        <p>{entry.data.earlyCareer.whatTheyDid}</p>
        <p>{entry.data.earlyCareer.itLedTo}</p>
        <a href={entry.data.earlyCareer.source}>来源</a>
      </aside>
    )}
    <Content />
  </section>
  <section class="section">
    <div class="grid cols-3">
      {concepts.map((item) => (
        <RelationCard href={`/concepts/${item.id}/`} title={item.data.title} description={item.data.summary} meta="concept" />
      ))}
      {entry.data.works.map((work) => (
        <RelationCard href={work.url ?? "#"} title={work.title} description={work.role} meta={work.type} />
      ))}
      {entry.data.sources.map((source) => (
        <RelationCard href={source.url} title={source.label} description="可验证来源" meta="source" />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .detail-header {
    padding-bottom: 22px;
    border-bottom: 1px solid var(--color-line);
  }

  h1 {
    margin: 0;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.08;
    letter-spacing: 0;
  }

  .person-quote {
    margin: 0;
    padding-left: 18px;
    border-left: 3px solid var(--color-accent);
    color: var(--color-ink);
    font-size: 20px;
    line-height: 1.55;
  }

  .early-career {
    display: grid;
    gap: 8px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 16px;
    background: var(--color-soft);
  }

  .early-career-label {
    margin: 0;
    color: var(--color-blue);
    font-size: 13px;
    font-weight: 800;
  }

  .early-career h2 {
    margin: 0;
    font-size: 22px;
    line-height: 1.3;
  }

  .early-career p {
    margin: 0;
    color: var(--color-muted);
  }

  .early-career a {
    width: fit-content;
    color: var(--color-blue);
    font-weight: 700;
  }
</style>
