---
import SearchBox from "../components/react/SearchBox";
import { getSearchDocuments } from "../lib/search-index";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Python 知识外脑" } = Astro.props;
const searchDocs = await getSearchDocuments();
const nav = [
  { href: "/path/", label: "路径" },
  { href: "/concepts/", label: "概念" },
  { href: "/cases/", label: "案例" },
  { href: "/projects/", label: "项目" },
  { href: "/people/", label: "人物" },
  { href: "/graph/", label: "图谱" }
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · Python 知识外脑</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <nav class="site-nav" aria-label="主导航">
          <a class="brand" href="/">
            <span class="brand-mark">Py</span>
            <span>Python 知识外脑</span>
          </a>
          <div class="nav-links">
            {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>
          <SearchBox docs={searchDocs} client:idle />
        </nav>
      </header>
      <main class="page">
        <slot />
      </main>
    </div>
  </body>
</html>
