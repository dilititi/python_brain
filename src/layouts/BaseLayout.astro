---
import SearchBox from "../components/astro/SearchBox.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "问题驱动的思想工作台" } = Astro.props;
const nav = [
  { href: "/philosophy/", label: "思想" },
  { href: "/philosophy/review/", label: "回顾" },
  { href: "/philosophy/next/", label: "下一步" },
  { href: "/philosophy/evidence/", label: "证据" },
  { href: "/philosophy/gaps/", label: "缺口" },
  { href: "/questions/", label: "问题" },
  { href: "/readings/", label: "阅读" },
  { href: "/concepts/", label: "Python" },
  { href: "/graph/", label: "图谱" }
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · 思想工作台</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <nav class="site-nav" aria-label="主导航">
          <a class="brand" href="/">
            <span class="brand-mark">思</span>
            <span>思想工作台</span>
          </a>
          <div class="nav-links">
            {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>
          <SearchBox />
        </nav>
      </header>
      <main class="page">
        <slot />
      </main>
    </div>
  </body>
</html>
