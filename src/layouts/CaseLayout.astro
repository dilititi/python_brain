---
import { render } from "astro:content";
import Breadcrumb from "../components/astro/Breadcrumb.astro";
import RelationCard from "../components/astro/RelationCard.astro";
import type { CaseEntry, ConceptEntry, PersonEntry, ProjectEntry } from "../lib/relations";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  entry: CaseEntry;
  concepts: ConceptEntry[];
  projects: ProjectEntry[];
  people: PersonEntry[];
}

const { entry, concepts, projects, people } = Astro.props as Props;
const { Content } = await render(entry);
const codeVersions = entry.data.codeVersions;
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <Breadcrumb
    items={[
      { label: "首页", href: "/" },
      { label: "案例", href: "/cases/" },
      { label: entry.data.title }
    ]}
  />
  <header class="detail-header">
    <p class="eyebrow">{entry.data.level}</p>
    <h1>{entry.data.title}</h1>
    <p class="lead">{entry.data.description}</p>
  </header>
  <section class="section content-flow">
    <p><strong>场景：</strong>{entry.data.scenario}</p>
    {entry.data.sourceUrl && (
      <p class="source-line">
        <strong>来源：</strong>
        <a href={entry.data.sourceUrl}>查看固定源码或资料</a>
      </p>
    )}
    <Content />
    {codeVersions.map((version) => (
      <article class="code-version">
        <p class="code-label">{version.label}</p>
        <pre><code>{version.code}</code></pre>
      </article>
    ))}
    <div class="case-notes">
      <section>
        <h2>常见坑</h2>
        <ul>
          {entry.data.pitfalls.map((item) => <li>{item}</li>)}
        </ul>
      </section>
      <section>
        <h2>延伸方向</h2>
        <ul>
          {entry.data.extensions.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    </div>
  </section>
  <section class="section">
    <div class="grid cols-3">
      {concepts.map((item) => (
        <RelationCard href={`/concepts/${item.id}/`} title={item.data.title} description={item.data.summary} meta="concept" />
      ))}
      {projects.map((item) => (
        <RelationCard href={`/projects/${item.id}/`} title={item.data.title} description={item.data.description} meta="project" />
      ))}
      {people.map((item) => (
        <RelationCard href={`/people/${item.id}/`} title={item.data.name} description={item.data.description} meta="person" />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .detail-header {
    padding-bottom: 22px;
    border-bottom: 1px solid var(--color-line);
  }

  h1 {
    margin: 0;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.08;
    letter-spacing: 0;
  }

  .code-version {
    display: grid;
    gap: 8px;
  }

  .code-label {
    margin: 0;
    color: var(--color-muted);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .case-notes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .source-line a {
    color: var(--color-accent);
    font-weight: 700;
  }

  h2 {
    margin: 0 0 10px;
    font-size: 18px;
  }

  ul {
    margin: 0;
    padding-left: 18px;
    color: var(--color-muted);
  }

  @media (max-width: 720px) {
    .case-notes {
      grid-template-columns: 1fr;
    }
  }
</style>
