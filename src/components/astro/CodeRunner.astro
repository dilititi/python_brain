---
type CodeExample = {
  title: string;
  description: string;
  code: string;
  runnable?: boolean;
};

interface Props {
  examples: CodeExample[];
}

const { examples } = Astro.props;
const defaultIndex = Math.max(0, examples.findIndex((example) => example.title === "standard"));
const firstExample = examples[defaultIndex];
---

{examples.length > 0 && (
  <div class="code-runner" data-code-runner>
    <div class="example-tabs" role="tablist" aria-label="代码示例">
      {examples.map((example, index) => (
        <button
          type="button"
          class:list={[index === defaultIndex && "active"]}
          data-example-index={index}
          aria-selected={index === defaultIndex ? "true" : "false"}
          role="tab"
        >
          {example.title}
        </button>
      ))}
    </div>
    <p data-code-description>{firstExample.description}</p>
    <textarea spellcheck="false" aria-label="Python 代码" data-code-editor>{firstExample.code}</textarea>
    <div class="island-toolbar">
      <button type="button" data-code-run>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16">
          <path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"></path>
        </svg>
        <span data-code-run-label>运行</span>
      </button>
    </div>
    <pre class="runner-output" data-code-output> </pre>
    <script is:inline type="application/json" data-code-examples set:html={JSON.stringify(examples)} />
  </div>
)}

<script is:inline>
  (() => {
    const pyodideVersion = "0.29.4";
    const pyodideBase = `https://cdn.jsdelivr.net/pyodide/v${pyodideVersion}/full/`;

    function loadScript() {
      return new Promise((resolve, reject) => {
        const existing = document.querySelector(`script[src="${pyodideBase}pyodide.js"]`);
        if (existing) {
          existing.addEventListener("load", () => resolve(), { once: true });
          existing.addEventListener("error", () => reject(new Error("Pyodide 加载失败")), { once: true });
          return;
        }

        const script = document.createElement("script");
        script.src = `${pyodideBase}pyodide.js`;
        script.async = true;
        script.onload = () => resolve();
        script.onerror = () => reject(new Error("Pyodide 加载失败"));
        document.head.append(script);
      });
    }

    async function ensurePyodide(root) {
      if (root.pyodide) {
        return root.pyodide;
      }

      if (!window.loadPyodide) {
        await loadScript();
      }

      if (!window.loadPyodide) {
        throw new Error("Pyodide 入口不可用");
      }

      root.pyodide = await window.loadPyodide({ indexURL: pyodideBase });
      return root.pyodide;
    }

    function bindRunner(root) {
      if (!(root instanceof HTMLElement) || root.dataset.bound === "true") {
        return;
      }

      root.dataset.bound = "true";

      const examplesSource = root.querySelector("[data-code-examples]");
      const description = root.querySelector("[data-code-description]");
      const editor = root.querySelector("[data-code-editor]");
      const output = root.querySelector("[data-code-output]");
      const runButton = root.querySelector("[data-code-run]");
      const runLabel = root.querySelector("[data-code-run-label]");
      const tabs = [...root.querySelectorAll("[data-example-index]")];

      if (!examplesSource || !(description instanceof HTMLElement) || !(editor instanceof HTMLTextAreaElement) || !(output instanceof HTMLElement) || !(runButton instanceof HTMLButtonElement) || !(runLabel instanceof HTMLElement)) {
        return;
      }

      let examples = [];
      try {
        examples = JSON.parse(examplesSource.textContent || "[]");
      } catch {
        examples = [];
      }

      function choose(index) {
        const example = examples[index];
        if (!example) {
          return;
        }

        for (const tab of tabs) {
          if (!(tab instanceof HTMLButtonElement)) {
            continue;
          }

          const active = tab.dataset.exampleIndex === String(index);
          tab.classList.toggle("active", active);
          tab.setAttribute("aria-selected", String(active));
        }

        description.textContent = example.description || "";
        editor.value = example.code || "";
        output.textContent = " ";
      }

      for (const tab of tabs) {
        tab.addEventListener("click", () => choose(Number(tab.dataset.exampleIndex || 0)));
      }

      runButton.addEventListener("click", async () => {
        runButton.disabled = true;
        runLabel.textContent = "运行中";
        output.textContent = "";

        try {
          const pyodide = await ensurePyodide(root);
          const chunks = [];
          const append = (text) => {
            chunks.push(text);
            output.textContent = chunks.join("");
          };

          pyodide.setStdout({ batched: append });
          pyodide.setStderr({ batched: append });
          const result = await pyodide.runPythonAsync(editor.value);

          if (result !== undefined) {
            append(String(result));
          }
        } catch (error) {
          output.textContent = error instanceof Error ? error.message : String(error);
        } finally {
          runButton.disabled = false;
          runLabel.textContent = "运行";
        }
      });
    }

    const roots = [...document.querySelectorAll("[data-code-runner]")];

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            bindRunner(entry.target);
            observer.unobserve(entry.target);
          }
        }
      });

      for (const root of roots) {
        observer.observe(root);
      }
    } else {
      for (const root of roots) {
        bindRunner(root);
      }
    }

    function bindVisibleRunners() {
      for (const root of roots) {
        if (root instanceof HTMLElement && root.offsetParent !== null) {
          bindRunner(root);
        }
      }
    }

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest('[data-tab-target="code"]')) {
        window.requestAnimationFrame(bindVisibleRunners);
      }
    });
    window.addEventListener("hashchange", () => window.requestAnimationFrame(bindVisibleRunners));
  })();
</script>

<style>
  .code-runner {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 14px;
    background: var(--color-panel);
    box-shadow: var(--shadow-panel);
  }

  .example-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }

  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 36px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    padding: 6px 10px;
    background: var(--color-panel);
    color: var(--color-ink);
    font-size: 14px;
    cursor: pointer;
  }

  button.active {
    border-color: var(--color-blue);
    color: var(--color-blue);
    background: #eff6ff;
  }

  button:disabled {
    cursor: wait;
    opacity: 0.72;
  }

  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  p {
    margin: 0 0 12px;
    color: var(--color-muted);
  }

  textarea {
    width: 100%;
    min-height: 220px;
    resize: vertical;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 12px;
    color: #f8fafc;
    background: #101828;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.55;
  }

  .island-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin: 12px 0;
  }

  .runner-output {
    min-height: 90px;
    margin: 0;
    white-space: pre-wrap;
  }
</style>
