---
interface Props {
  href: string;
  title: string;
  description?: string;
  meta?: string;
}

const { href, title, description, meta } = Astro.props;
---

<a class="relation-card" href={href}>
  {meta && <span class="relation-meta">{meta}</span>}
  <strong>{title}</strong>
  {description && <p>{description}</p>}
</a>

<style>
  .relation-card {
    min-width: 0;
    display: grid;
    gap: 8px;
    height: 100%;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 14px;
    background: var(--color-panel);
  }

  .relation-card:hover {
    border-color: var(--color-blue);
    color: var(--color-ink);
  }

  strong {
    line-height: 1.3;
  }

  p {
    margin: 0;
    color: var(--color-muted);
    font-size: 14px;
  }

  .relation-meta {
    color: var(--color-faint);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }
</style>
